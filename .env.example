# ProphecyVerse Server Environment Configuration (copy to .env, never commit secrets)
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# MovieBox Upstream Provider Configuration (server-side only)
# Optional overrides; leave blank to use protocol defaults
MOVIEBOX_API_HOSTS=https://api6.aoneroom.com,https://api5.aoneroom.com,https://api4.aoneroom.com,https://api4sg.aoneroom.com,https://api3.aoneroom.com,https://api6sg.aoneroom.com,https://api.inmoviebox.com
MOVIEBOX_SIGNING_SECRET=
MOVIEBOX_AUTH_TOKEN=
MOVIEBOX_CERT_SHA256=
MOVIEBOX_BUILD_SALT=
MOVIEBOX_USER_AGENT=
MOVIEBOX_CLIENT_INFO=

# Trusted CDN hostnames for stream & subtitle proxy (comma-separated domain suffixes)
MOVIEBOX_MEDIA_HOSTS=aoneroom.com,inmoviebox.com,hakunaymatata.com
MOVIEBOX_STREAM_REFERER=

# Stream Proxy Signing & Limits
STREAM_PROXY_SECRET=
STREAM_PROXY_TTL_SECONDS=3600
STREAM_PROXY_TIMEOUT_MS=30000

# Caching & Rate Limiting
MOVIEBOX_CACHE_TTL_MS=300000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Offline / CI Mock Provider Mode (set to true to serve deterministic mock catalog & streams)
MOVIEBOX_MOCK_MODE=false
