rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() {
      return signedIn() && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.is_admin == true;
    }
    function ownsInstallation(installationId) {
      let installationPath = /databases/$(database)/documents/installations/$(request.auth.uid + '_' + installationId);
      return exists(installationPath)
        && get(installationPath).data.owner_uid == request.auth.uid
        && get(installationPath).data.installation_id == installationId;
    }
    match /admin_users/{uid} { allow read, write: if admin(); }
    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if owner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.download_blocked == false;
      allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'last_login_at', 'app_version', 'app_version_code', 'installation_id', 'email', 'uid', 'is_anonymous'
      ]) || admin();
      allow delete: if admin();
    }
    match /installations/{id} {
      allow read: if admin() || (signedIn() && resource.data.owner_uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.installation_id is string
        && request.resource.data.keys().hasAll(['owner_uid', 'installation_id'])
        && request.resource.data.keys().hasOnly([
          'owner_uid','installation_id','session_id','session_start_at','device_manufacturer','device_model','device_brand',
          'android_version','sdk_int','app_version_name','app_version_code','locale','country_code','installed_at',
          'last_active_at','last_heartbeat_at','activity_status','fcm_status','fcm_token','total_watch_seconds'
        ]);
      allow update: if signedIn()
        && resource.data.owner_uid == request.auth.uid
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.installation_id is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'installation_id','session_id','session_start_at','device_manufacturer','device_model','device_brand',
          'android_version','sdk_int','app_version_name','app_version_code','locale','country_code','installed_at',
          'last_active_at','last_heartbeat_at','activity_status','fcm_status','fcm_token','total_watch_seconds'
        ]);
      allow delete: if admin() || (signedIn() && resource.data.owner_uid == request.auth.uid);
    }
    match /watch_history/{uid}/{sub=**} { allow read, write: if owner(uid) || admin(); }
    match /watchlist/{uid}/{sub=**} { allow read, write: if owner(uid) || admin(); }
    match /app_config/{id} { allow read: if true; allow write: if admin(); }
    match /notices/{id} { allow read: if true; allow write: if admin(); }
    match /notifications/{id} { allow read, write: if admin(); }
    match /security_logs/{id} { allow read: if admin(); allow create: if admin(); allow update, delete: if false; }
    match /analytics_events/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['event_name', 'installation_id', 'user_id', 'timestamp', 'params'])
        && request.resource.data.keys().hasOnly(['event_name', 'installation_id', 'user_id', 'timestamp', 'params'])
        && request.resource.data.event_name in [
          'anime_view', 'episode_play', 'app_open', 'notification_permission_granted', 'register_success', 'login_success'
        ]
        && request.resource.data.installation_id is string
        && request.resource.data.installation_id.size() <= 128
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.timestamp is int
        && request.resource.data.timestamp > 0
        && request.resource.data.params is map
        && request.resource.data.params.keys().hasOnly(['anime_id', 'episode_id', 'episode_number'])
        && (!('anime_id' in request.resource.data.params.keys()) || (request.resource.data.params.anime_id is string && request.resource.data.params.anime_id.size() <= 256))
        && (!('episode_id' in request.resource.data.params.keys()) || (request.resource.data.params.episode_id is string && request.resource.data.params.episode_id.size() <= 256))
        && (!('episode_number' in request.resource.data.params.keys()) || request.resource.data.params.episode_number is int)
        && ownsInstallation(request.resource.data.installation_id);
      allow read: if admin();
      allow update, delete: if false;
    }
    // Shared catalog metadata is backend-shaped, URL-only metadata. Client writes are
    // constrained to the allow-listed schema; playback/source URLs are not valid fields.
    function validCatalogRecord(expectedType, documentId) {
      return signedIn()
        && request.resource.data.keys().hasAll([
          'documentId', 'backendId', 'contentType', 'schemaVersion', 'metadataHash',
          'createdAt', 'updatedAt', 'lastSyncedAt', 'source'
        ])
        && request.resource.data.keys().hasOnly([
          'documentId', 'canonicalId', 'backendId', 'contentType', 'schemaVersion', 'metadataHash',
          'title', 'normalizedTitle', 'searchKeywords', 'description', 'posterUrl', 'bannerUrl', 'mediaType', 'releaseYear', 'genres',
          'seasonNumber', 'episodeNumber', 'episodeTitle', 'episodeDescription',
          'parentCanonicalId', 'parentBackendId', 'source', 'createdAt', 'updatedAt', 'lastSyncedAt'
        ])
        && request.resource.data.documentId == documentId
        && request.resource.data.backendId is string
        && request.resource.data.backendId.size() > 0
        && request.resource.data.contentType == expectedType
        && request.resource.data.schemaVersion == 1
        && request.resource.data.metadataHash is string
        && request.resource.data.metadataHash.size() == 64
        && request.resource.data.source == 'prophecyverse_backend'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.lastSyncedAt is timestamp
        && (!('canonicalId' in request.resource.data.keys()) || request.resource.data.canonicalId is string)
        && (!('title' in request.resource.data.keys()) || request.resource.data.title is string)
        && (!('normalizedTitle' in request.resource.data.keys()) || request.resource.data.normalizedTitle is string)
        && (!('searchKeywords' in request.resource.data.keys()) || request.resource.data.searchKeywords is list)
        && (!('description' in request.resource.data.keys()) || request.resource.data.description is string)
        && (!('posterUrl' in request.resource.data.keys()) || request.resource.data.posterUrl is string)
        && (!('bannerUrl' in request.resource.data.keys()) || request.resource.data.bannerUrl is string)
        && (!('mediaType' in request.resource.data.keys()) || request.resource.data.mediaType is string)
        && (!('releaseYear' in request.resource.data.keys()) || request.resource.data.releaseYear is string)
        && (!('genres' in request.resource.data.keys()) || request.resource.data.genres is list)
        && (!('seasonNumber' in request.resource.data.keys()) || request.resource.data.seasonNumber is int)
        && (!('episodeNumber' in request.resource.data.keys()) || request.resource.data.episodeNumber is int)
        && (!('episodeTitle' in request.resource.data.keys()) || request.resource.data.episodeTitle is string)
        && (!('episodeDescription' in request.resource.data.keys()) || request.resource.data.episodeDescription is string)
        && (!('parentCanonicalId' in request.resource.data.keys()) || request.resource.data.parentCanonicalId is string)
        && (!('parentBackendId' in request.resource.data.keys()) || request.resource.data.parentBackendId is string);
    }
    function catalogUpdate(expectedType, documentId) {
      return validCatalogRecord(expectedType, documentId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.documentId == resource.data.documentId
        && request.resource.data.backendId == resource.data.backendId
        && request.resource.data.contentType == resource.data.contentType
        && request.resource.data.source == resource.data.source;
    }
    match /shared_catalog_anime/{id} {
      allow read: if signedIn();
      allow create: if validCatalogRecord('ANIME', id);
      allow update: if catalogUpdate('ANIME', id);
      allow delete: if admin();
    }
    match /shared_catalog_movies/{id} {
      allow read: if signedIn();
      allow create: if validCatalogRecord('MOVIE', id);
      allow update: if catalogUpdate('MOVIE', id);
      allow delete: if admin();
    }
    match /shared_catalog_seasons/{id} {
      allow read: if signedIn();
      allow create: if validCatalogRecord('SEASON', id);
      allow update: if catalogUpdate('SEASON', id);
      allow delete: if admin();
    }
    match /shared_catalog_episodes/{id} {
      allow read: if signedIn();
      allow create: if validCatalogRecord('EPISODE', id);
      allow update: if catalogUpdate('EPISODE', id);
      allow delete: if admin();
    }
    match /shared_catalog_genres/{id} {
      allow read: if signedIn();
      allow create: if validCatalogRecord('GENRE', id);
      allow update: if catalogUpdate('GENRE', id);
      allow delete: if admin();
    }
    match /shared_catalog_categories/{id} {
      allow read: if signedIn();
      allow create: if validCatalogRecord('CATEGORY', id);
      allow update: if catalogUpdate('CATEGORY', id);
      allow delete: if admin();
    }
    match /update_history/{id} { allow read, write: if admin(); }
    match /analytics_daily/{id} { allow read, write: if admin(); }
    match /admin_settings/{id} { allow read, write: if admin(); }
  }
}
