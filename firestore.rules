rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    // User profiles: strictly owner access or admin
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Device installation registry: each device can register and heartbeat its installation
    match /installations/{installationId} {
      allow read, write: if true;
    }

    // Watch history & continue watching per user / installation
    match /watch_history/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /episodes/{episodeId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // User library / watchlist
    match /watchlist/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /items/{animeId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Client analytics events: allows write without auth so install/open events can be recorded
    match /analytics_events/{eventId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Daily aggregated metrics
    match /analytics_daily/{dateDoc} {
      allow read: if isAdmin();
      allow write: if isAuthenticated();
    }

    // Global App Configuration & Version Control: Publicly readable, writeable only by Admin
    match /app_config/{configDoc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Announcements and push notification broadcast metadata
    match /notifications/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Future Admin APK management and configuration
    match /admin_settings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /admin_activity_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
