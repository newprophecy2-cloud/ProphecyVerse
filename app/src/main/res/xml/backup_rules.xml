<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Installation UUID, FCM token, Room stream cache DB, and D1 digest prefs are device-local; do not back up or restore across installs. -->
    <exclude domain="sharedpref" path="prophecy_install_prefs.xml" />
    <exclude domain="sharedpref" path="prophecy_d1_digests.xml" />
    <exclude domain="database" path="prophecyverse.db" />
    <exclude domain="database" path="prophecyverse.db-wal" />
    <exclude domain="database" path="prophecyverse.db-shm" />
    <exclude domain="database" path="prophecyverse.db-journal" />
</full-backup-content>
